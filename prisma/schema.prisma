generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  owner
  profe
}

enum ChangeReason {
  cambio
  feriado
}

enum PaymentStatus {
  pending
  approved
  rejected
}

enum PaymentSource {
  manual
  mercadopago
}

enum ChatAuthorKind {
  student
  admin
}

// Fila única (id fijo = 1) con la configuración general del taller.
model Config {
  id                     Int      @id @default(1)
  studioName             String   @default("Taller de Cerámica")
  capacity               Int      @default(8)
  classesPerCycle        Int      @default(4)
  swapsPerMonth          Int      @default(1)
  paymentWindowStart     Int      @default(1)
  paymentWindowEnd       Int      @default(10)
  cashFee                Int      @default(15000)
  mpFee                  Int      @default(15000)
  lateFeePercent         Int      @default(20)
  mpLink                 String?
  theme                  String   @default("florar")
  defaultStudentPin      String   @default("0000")
  profeWhatsapp          String?
  announcementVisibleDays Int     @default(7)
  studentInfo            String   @default("")
  updatedAt              DateTime @updatedAt
}

model Slot {
  id       String @id
  weekdays Int[]  @default([])
  start    String
  end      String
  order    Int    @default(0)

  students         Student[]
  slotAssignments  SlotAssignment[]
  substitutions    Substitution[]
  fromChanges      ScheduleChange[] @relation("FromSlot")
  toChanges        ScheduleChange[] @relation("ToSlot")
  chatMessages     ChatMessage[]
  adminChatSeens   AdminChatSeen[]
}

model Holiday {
  date  DateTime @id @db.Date
  label String?
}

model Admin {
  username     String    @id
  passwordHash String
  role         AdminRole
  isMainProfe  Boolean   @default(false)
  tutorialSeen Boolean   @default(false)
  displayName  String?
  createdAt    DateTime  @default(now())
  avisosSeenAt DateTime?
  blogSeenAt   DateTime?

  slotAssignments SlotAssignment[] @relation("AdminSlotAssignments")
  substitutions   Substitution[]   @relation("AdminSubstitutions")
  notifications   Notification[]
  chatMessages    ChatMessage[]
  chatSeens       AdminChatSeen[]
}

// Última vez que una profe vio el chat de un turno puntual — a diferencia de avisos/blog, el chat
// es por turno (la profe principal ve varios), así que el "visto" también tiene que serlo.
model AdminChatSeen {
  adminUsername String
  admin         Admin    @relation(fields: [adminUsername], references: [username], onDelete: Cascade)
  weekday       Int
  slotId        String
  slot          Slot     @relation(fields: [slotId], references: [id])
  seenAt        DateTime @default(now())

  @@id([adminUsername, weekday, slotId])
}

model Student {
  id              String   @id
  name            String
  pin             String
  defaultWeekday  Int
  defaultSlotId   String
  defaultSlot     Slot     @relation(fields: [defaultSlotId], references: [id])
  theme           String?
  nick            String?
  mustChangePin   Boolean  @default(true)
  tutorialSeen    Boolean  @default(false)
  createdAt       DateTime @default(now())
  avisosSeenAt    DateTime?
  chatSeenAt      DateTime?
  blogSeenAt      DateTime?

  scheduleChanges ScheduleChange[]
  payments        Payment[]
  pinResets       PinResetRequest[]
  chatMessages    ChatMessage[]
  posts           StudentPost[]

  @@index([defaultWeekday, defaultSlotId])
}

model SlotAssignment {
  weekday      Int
  slotId       String
  slot         Slot   @relation(fields: [slotId], references: [id])
  profeUsername String
  profe        Admin  @relation("AdminSlotAssignments", fields: [profeUsername], references: [username])

  @@id([weekday, slotId])
}

model Substitution {
  date          DateTime @db.Date
  slotId        String
  slot          Slot     @relation(fields: [slotId], references: [id])
  profeUsername String
  profe         Admin    @relation("AdminSubstitutions", fields: [profeUsername], references: [username])

  @@id([date, slotId])
}

// Un cambio de turno puntual: reemplaza a los antiguos "overrides" + "extraBookings",
// que siempre se escribían juntos para representar el mismo hecho.
model ScheduleChange {
  id         String       @id @default(cuid())
  studentId  String
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromDate   DateTime     @db.Date
  fromSlotId String
  fromSlot   Slot         @relation("FromSlot", fields: [fromSlotId], references: [id])
  toDate     DateTime     @db.Date
  toSlotId   String
  toSlot     Slot         @relation("ToSlot", fields: [toSlotId], references: [id])
  reason     ChangeReason
  monthKey   String
  createdAt  DateTime     @default(now())

  @@unique([studentId, fromDate])
  @@index([toDate, toSlotId])
  @@index([studentId, monthKey])
}

// Reemplaza "paidMonths" (en el alumno) y la base separada del backend de Mercado Pago:
// una sola fila por alumno+mes es la fuente de verdad de si está pagado.
model Payment {
  id           String        @id @default(cuid())
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  monthKey     String
  amount       Int
  status       PaymentStatus @default(pending)
  source       PaymentSource
  mpPaymentId  String?
  mpPreferenceId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([studentId, monthKey])
}

model PinResetRequest {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedAt DateTime @default(now())
}

model Activity {
  id          String   @id @default(cuid())
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  title       String
  description String?
  createdAt   DateTime @default(now())
}

// weekday+slotId nulos = aviso para todos los alumnos; si están cargados, solo lo ven los
// alumnos de ese turno puntual (mismo día+horario fijo que usa el chat).
model Announcement {
  id             String   @id @default(cuid())
  message        String
  authorUsername String?
  weekday        Int?
  slotId         String?
  createdAt      DateTime @default(now())
}

// Posts tipo blog de la profe: links, fotos e ideas — a diferencia de Announcement,
// no es urgente ni se filtra por antigüedad, queda como un registro permanente.
// "featured"+"sourceStudentPostId" son para cuando una profe retuitea una publicación de la
// bitácora de un alumno hacia acá: queda con crédito al alumno y marcada como destacada.
model BlogPost {
  id                  String   @id @default(cuid())
  title               String?
  body                String
  imageData           String?
  authorUsername      String?
  featured            Boolean  @default(false)
  studentAuthorName   String?
  sourceStudentPostId String?
  createdAt           DateTime @default(now())
}

// Bitácora personal del alumno: sus propias piezas/avances, con foto y descripción. Privada por
// defecto (solo la ve el alumno dueño y las profes); una profe puede marcarla "pública" para que
// la vean también otros alumnos, y/o destacarla en el CeramiBlog (crea un BlogPost vinculado).
model StudentPost {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String?
  body      String
  imageData String?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

// Chat del turno: solo lo ven los alumnos de ese día+horario fijo y el profe asignado (o la
// profe principal, para poder moderar). authorName queda fijo al momento de escribir para que
// el mensaje siga siendo legible aunque esa cuenta se borre después.
model ChatMessage {
  id                  String         @id @default(cuid())
  weekday             Int
  slotId              String
  slot                Slot           @relation(fields: [slotId], references: [id])
  authorKind          ChatAuthorKind
  authorName          String
  authorStudentId     String?
  authorStudent       Student?       @relation(fields: [authorStudentId], references: [id], onDelete: SetNull)
  authorAdminUsername String?
  authorAdmin         Admin?         @relation(fields: [authorAdminUsername], references: [username], onDelete: SetNull)
  body                String
  // Foto propia (subida a Vercel Blob) o GIF (alojado en Giphy, se guarda el link tal cual).
  attachmentUrl       String?
  attachmentType      String?
  createdAt           DateTime       @default(now())

  @@index([weekday, slotId, createdAt])
}

// "Me gusta" de un post de CeramiBlog o de bitácora. postType+postId es una referencia liviana
// (sin FK) para no tener que declarar una relación separada por cada tipo de post.
model PostLike {
  id        String   @id @default(cuid())
  postType  String
  postId    String
  actorKey  String
  createdAt DateTime @default(now())

  @@unique([postType, postId, actorKey])
  @@index([postType, postId])
}

// Comentario de texto simple sobre un post de CeramiBlog o de bitácora — sin hilos, como en
// Instagram. authorName queda fijo al momento de comentar, igual que en el chat.
model PostComment {
  id         String   @id @default(cuid())
  postType   String
  postId     String
  authorName String
  actorKey   String
  body       String
  createdAt  DateTime @default(now())

  @@index([postType, postId, createdAt])
}

model Notification {
  id            String   @id @default(cuid())
  forProfe      String?
  profe         Admin?   @relation(fields: [forProfe], references: [username], onDelete: Cascade)
  message       String
  createdAt     DateTime @default(now())
}
