# Copiá este archivo como ".env" para desarrollo local y completá tus datos. Nunca subas el ".env" real al repo.

# Cadena de conexión a Postgres (Vercel Postgres/Neon te la da al crear la base).
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# Secreto para firmar las cookies de sesión (alumnos y profes). Cualquier string largo y random.
# Generalo por ejemplo con: openssl rand -base64 32
SESSION_SECRET="cambiar-por-un-secreto-largo-y-random"

# Mercado Pago — Access Token PRIVADO (Tus integraciones -> tu app -> Credenciales de producción).
# Sin esto, el cobro automático queda deshabilitado (el botón de pago cae al link manual si hay uno cargado).
MP_ACCESS_TOKEN=

# Clave secreta del webhook de Mercado Pago (Tus integraciones -> tu app -> Webhooks -> Firma secreta).
# Opcional pero muy recomendada: sin ella no se valida que el webhook realmente venga de Mercado Pago.
MP_WEBHOOK_SECRET=

# URL pública de la app en producción, sin barra final (ej: https://florar.vercel.app).
# Se usa para armar los links de vuelta de Mercado Pago y la URL del webhook. En Vercel podés
# dejarlo vacío en Preview/Development: si no está seteada, se arma sola a partir del request.
APP_URL=

# Token de Vercel Blob (guarda las fotos de CeramiBlog y bitácoras fuera de la base de datos).
# Se genera solo al crear/conectar un Blob store al proyecto en Vercel (Storage -> Blob), y en
# local lo baja automáticamente `vercel env pull` a .env.local — no hace falta copiarlo a mano.
BLOB_READ_WRITE_TOKEN=

# API key gratis de Giphy (developers.giphy.com -> Create an App -> API key), para el selector
# de GIFs del chat. Sin esto, el botón de GIF muestra un error pero el resto del chat funciona
# igual (no se usa Vercel Blob para los GIFs: quedan alojados en Giphy, no en nuestra base).
GIPHY_API_KEY=
