# Copiá este archivo como ".env" y completá tus datos reales. Nunca subas el ".env" a un repo público.

# Access Token PRIVADO de Mercado Pago (Tus integraciones -> tu app -> Credenciales de producción)
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# Clave secreta del webhook (Tus integraciones -> tu app -> Webhooks -> Firma secreta). Opcional pero recomendada.
MP_WEBHOOK_SECRET=

# URL pública donde vas a desplegar este servidor (ej: https://taller-mp.onrender.com). Sin barra final.
BASE_URL=

PORT=3000
